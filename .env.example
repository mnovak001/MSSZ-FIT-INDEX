# Database Configuration
DATABASE_URL="postgresql://fit:fit@localhost:5432/fit_szz?schema=public"

# Application Name
NEXT_PUBLIC_APP_NAME="FIT MSZZ Materiály"

# NextAuth Configuration
# Generate a strong random secret for production (e.g., using: openssl rand -base64 32)
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION"

# NextAuth URL (only needed if deploying behind a proxy or with custom domain)
# NEXTAUTH_URL="https://your-domain.com"

# Admin User Credentials (CHANGE THESE IMMEDIATELY AFTER FIRST SETUP!)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_THIS_TO_A_STRONG_PASSWORD"

# Security Settings
# Set to "production" in production environment
NODE_ENV="development"

# Rate Limiting (optional, can be configured via middleware)
# LOGIN_RATE_LIMIT_MAX=5
# LOGIN_RATE_LIMIT_WINDOW=900000